{
  "name": "ogtx-desktop",
  "version": "0.1.0",
  "description": "OGTX — لوحة إدارة مطعم OGTX لسطح المكتب",
  "private": true,
  "main": "out/main/index.js",
  "build": {
    "appId": "dz.ogtx.desktop",
    "productName": "OGTX",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OGTX",
      "language": "1025"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx scripts/test-auth.mts && tsx scripts/test-perms.mts && tsx scripts/test-orders.mts && tsx scripts/test-cashbox.mts && tsx scripts/test-menu.mts && tsx scripts/test-stock.mts",
    "smoke": "electron-vite build && electron . --smoke",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "0.17.4"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vite": "^7.3.6"
  }
}
